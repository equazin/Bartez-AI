# Bartez AI — variables de entorno (backend)
# Copiar a .env y completar. NUNCA commitear .env.

# --- Supabase (base de datos) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Anthropic (Claude) ---
ANTHROPIC_API_KEY=

# --- Ferozo (asistente de Correo) — IMAP + SMTP ---
# Datos típicos de Ferozo (confirmar en el panel de tu hosting):
#   IMAP host: mail.tudominio.com.ar   puerto 993  SSL/TLS
#   SMTP host: mail.tudominio.com.ar   puerto 465  SSL/TLS
# Usuario = la casilla completa (ej. contacto@bartez.com.ar)
FEROZO_EMAIL=
FEROZO_PASSWORD=
FEROZO_IMAP_HOST=
FEROZO_IMAP_PORT=993
FEROZO_SMTP_HOST=
FEROZO_SMTP_PORT=465
# 'true' para SSL directo (465), 'false' para STARTTLS (587)
FEROZO_SMTP_SECURE=true

# --- Envío por HTTPS con Resend (opcional) ---
# Railway en plan Hobby bloquea el SMTP: con esta clave los correos salen por
# Resend desde la misma casilla (el dominio tiene que estar verificado en
# resend.com/domains). La lectura sigue por IMAP y se guarda copia en Enviados.
RESEND_API_KEY=
# Remitente que ve el cliente (por defecto: "Bartez Tecnología <FEROZO_EMAIL>")
CORREO_REMITENTE=

# --- Notion (Fase 3: sync de prospectos/tareas/notas) ---
# 1. Ir a https://www.notion.so/my-integrations → New integration (Internal, "Bartez AI")
# 2. Copiar el "Internal Integration Token" (empieza con secret_...)
# 3. En Notion crear una página "Bartez AI" (o donde vayan a vivir los databases)
# 4. En esa página: "..." → Connections → Add connections → seleccionar "Bartez AI"
# 5. Copiar el ID de la página (la parte final de la URL, hex de 32 chars)
# 6. Al arrancar el backend con estas vars, los 3 databases se crean automáticamente
#    y sus IDs se guardan en integraciones_config (no hay que copiarlos a mano).
NOTION_TOKEN=
NOTION_PARENT_PAGE_ID=

# --- Proveedores (Cotizador) ---
# Credenciales de la API de cada mayorista (se sacan del portal de clientes).
# Elit: número de cliente y token (clientes.elit.com.ar → API)
ELIT_USER_ID=
ELIT_TOKEN=
# Air: usuario y contraseña de la intranet (el token se renueva solo), o solo
# AIR_TOKEN generado en la intranet (anda hasta que vence; después hay que reemplazarlo).
AIR_USER=
AIR_PASSWORD=
AIR_TOKEN=
# Invid: usuario y contraseña de integrador de la API
INVID_USER=
INVID_PASSWORD=

# Tipo de cambio para pasar USD → ARS. Vacío = dólar oficial venta (dolarapi.com).
TIPO_CAMBIO_FIJO=

# --- WhatsApp (vía el bot de bartez.com.ar) ---
# El bot de la web ya está conectado a Meta. Bartez AI lee sus conversaciones y
# manda mensajes por la API v1 de la web. El token se configura en
# bartez.com.ar/admin/sistema → Integraciones → "API v1" (mismo valor acá).
STUDIO_API_URL=https://bartez.com.ar
STUDIO_API_TOKEN=

# --- Escalamiento humano ---
ESCALACION_EMAIL=          # email al que van los avisos internos

# --- Server ---
PORT=3000

# --- Login del panel ---
# Contraseña para entrar al panel. OBLIGATORIA en Railway (sin ella el backend
# no arranca). En local podés dejarla vacía y el login queda desactivado.
PANEL_PASSWORD=
# Secreto extra para firmar las sesiones del panel. En Railway poné un texto
# largo al azar (cambiarlo cierra todas las sesiones abiertas).
AUTH_SECRET=
# Otros orígenes web que pueden usar el backend, separados por coma
# (localhost y https://equazin.github.io ya están permitidos).
FRONTEND_ORIGINS=
