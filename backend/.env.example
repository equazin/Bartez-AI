# Bartez AI — variables de entorno (backend)
# Copiar a .env y completar. NUNCA commitear .env.

# --- Supabase (base de datos) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Anthropic (Claude) ---
ANTHROPIC_API_KEY=

# --- Gmail (asistente de Correo) ---
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_USER_EMAIL=

# --- Notion ---
NOTION_TOKEN=
NOTION_DATABASE_ID_CLIENTES=
NOTION_DATABASE_ID_TAREAS=

# --- WhatsApp (Fase 3, aún no usado) ---
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# --- Escalamiento humano ---
ESCALACION_EMAIL=          # email al que van los avisos (correo del dueño)

# --- Server ---
PORT=3000
